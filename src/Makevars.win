CXX_STD = CXX17

# OpenMP parallelizes the loop over observations in dmrf_deriv() and cpp_npseudologlik() (argument ncores);
# Armadillo's own OpenMP use is switched off, so that no other computation runs on more than one thread
PKG_CPPFLAGS = -DARMA_NO_DEBUG -DARMA_DONT_USE_OPENMP -I.
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)

PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
